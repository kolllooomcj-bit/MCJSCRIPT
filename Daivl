-- Tạo toggle button
local function makeToggleButton(name, initialState, callback)
    local toggleState = initialState
    
    local btn = Instance.new("TextButton", scroll)
    btn.Size = UDim2.new(0,320,0,45)
    btn.BackgroundColor3 = initialState and Color3.fromRGB(20, 100, 50) or Color3.fromRGB(35,35,45)
    btn.Text = name .. (initialState and " [ON]" or " [OFF]")
    btn.TextColor3 = Color3.fromRGB(0,255,180)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 18
    btn.AutoButtonColor = true
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,10)

    local stroke = Instance.new("UIStroke", btn)
    stroke.Thickness = 1.2
    stroke.Color = initialState and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(0,255,180)
    stroke.Transparency = 0.5
    
    btn.MouseButton1Click:Connect(function()
        toggleState = not toggleState
        if toggleState then
            btn.BackgroundColor3 = Color3.fromRGB(20, 100, 50)
            stroke.Color = Color3.fromRGB(0, 255, 150)
            btn.Text = name .. " [ON]"
        else
            btn.BackgroundColor3 = Color3.fromRGB(35,35,45)
            stroke.Color = Color3.fromRGB(0,255,180)
            btn.Text = name .. " [OFF]"
        end
        callback(toggleState)
    end)
    
    return btn
end

