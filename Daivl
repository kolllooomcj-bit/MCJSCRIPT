local function createEspBox(player)
    if player == game.Players.LocalPlayer then return end
    if not player.Character then return end
    
    local humanoidRootPart = player.Character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    -- Tạo box outline
    local box = Instance.new("BoxHandleAdornment")
    box.Name = "MCJ_ESP_" .. player.Name
    box.Adornee = humanoidRootPart
    box.AlwaysOnTop = true
    box.ZIndex = 10
    box.Size = Vector3.new(3, 6, 1)
    box.Color3 = Color3.fromRGB(255, 50, 50)
    box.Transparency = 0.3
    box.Parent = humanoidRootPart
    
    -- Tạo billboard với tên và khoảng cách
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "MCJ_ESP_NAME_" .. player.Name
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 4, 0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = humanoidRootPart
    billboard.Parent = humanoidRootPart
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0.6, 0)
    nameLabel.Position = UDim2.new(0, 0, 0, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    nameLabel.TextSize = 20
    nameLabel.TextStrokeTransparency = 0.5
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Parent = billboard
    
    local distanceLabel = Instance.new("TextLabel")
    distanceLabel.Size = UDim2.new(1, 0, 0.4, 0)
    distanceLabel.Position = UDim2.new(0, 0, 0.6, 0)
    distanceLabel.BackgroundTransparency = 1
    distanceLabel.Text = "0 studs"
    distanceLabel.TextColor3 = Color3.fromRGB(200, 200, 100)
    distanceLabel.TextSize = 16
    distanceLabel.Font = Enum.Font.Gotham
    distanceLabel.Parent = billboard
    
    espBoxes[player] = {box = box, billboard = billboard}
end

local function updateEspPlayer()
    if not espPlayersEnabled then return end
    
    for player, data in pairs(espBoxes) do
        if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = player.Character.HumanoidRootPart
            local localChar = game.Players.LocalPlayer.Character
            local localHrp = localChar and localChar:FindFirstChild("HumanoidRootPart")
            
            if localHrp then
                local distance = (hrp.Position - localHrp.Position).Magnitude
                data.billboard:FindFirstChild("TextLabel"):FindFirstChild("TextLabel").Text = math.floor(distance) .. " studs"
                
                -- Đổi màu theo distance
                if distance < 50 then
                    data.box.Color3 = Color3.fromRGB(255, 50, 50) -- Đỏ (gần)
                elseif distance < 100 then
                    data.box.Color3 = Color3.fromRGB(255, 150, 50) -- Cam
                else
                    data.box.Color3 = Color3.fromRGB(50, 200, 50) -- Xanh (xa)
                end
            end
        else
            -- Clean up nếu player không còn tồn tại
            if data.box then data.box:Destroy() end
            if data.billboard then data.billboard:Destroy() end
            espBoxes[player] = nil
        end
    end
end

local function enableEspPlayers()
    if espPlayersEnabled then return end
    espPlayersEnabled = true
    print("[MCJ] ESP Players: Đang bật...")
    
    -- Tạo ESP cho players hiện có
    for _, player in pairs(Players:GetPlayers()) do
        createEspBox(player)
    end
    
    -- Thêm ESP cho players mới
    espPlayersConnection = Players.PlayerAdded:Connect(function(player)
        createEspBox(player)
    end)
    
    -- Xóa ESP khi player leave
    Players.PlayerRemoving:Connect(function(player)
        if espBoxes[player] then
            if espBoxes[player].box then espBoxes[player].box:Destroy() end
            if espBoxes[player].billboard then espBoxes[player].billboard:Destroy() end
            espBoxes[player] = nil
        end
    end)
    
    -- Update loop
    task.spawn(function()
        while espPlayersEnabled do
            updateEspPlayer()
            task.wait(0.1)
        end
    end)
    
    print("[MCJ] ESP Players: Đã bật")
end

local function disableEspPlayers()
    if not espPlayersEnabled then return end
    espPlayersEnabled = false
    print("[MCJ] ESP Players: Đang tắt...")
    
    if espPlayersConnection then
        espPlayersConnection:Disconnect()
        espPlayersConnection = nil
    end
    
    for player, data in pairs(espBoxes) do
        if data.box then data.box:Destroy() end
        if data.billboard then data.billboard:Destroy() end
    end
    espBoxes = {}
    
    print("[MCJ] ESP Players: Đã tắt")
end

-- ========== ANTI LAG ==========
local character = player.Character or player.CharacterAdded:Wait()

local function removeClothes()
    if not character then return end
    for _, v in pairs(character:GetChildren()) do
        if v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("Accessory") then
            v:Destroy()
        end
    end
end

local function removePartTextures(obj)
    if obj:IsA("Texture") or obj:IsA("Decal") or obj:IsA("SurfaceAppearance") then
        obj:Destroy()
    end
end

local function enableAntiLag()
    if antiLagEnabled then return end
    antiLagEnabled = true
    print("[MCJ] Anti Lag: Đang bật...")
    
    removeClothes()
    
    local charConnection = player.CharacterAdded:Connect(function(c)
        character = c
        task.wait(0.1)
        removeClothes()
    end)
    table.insert(antiLagConnections, charConnection)
    
    local clothesLoop = task.spawn(function()
        while antiLagEnabled do
            if character then removeClothes() end
            task.wait(1)
        end
    end)
    table.insert(antiLagConnections, clothesLoop)
    
    for _,v in pairs(workspace:GetDescendants()) do
        removePartTextures(v)
    end
    local textureConnection = workspace.DescendantAdded:Connect(removePartTextures)
    table.insert(antiLagConnections, textureConnection)
    
    print("[MCJ] Anti Lag: Đã bật")
end

local function disableAntiLag()
    if not antiLagEnabled then return end
    antiLagEnabled = false
    print("[MCJ] Anti Lag: Đang tắt...")
    for _, connection in pairs(antiLagConnections) do
        if type(connection) == "userdata" and connection.Connected then
            connection:Disconnect()
        elseif type(connection) == "thread" then
            task.cancel(connection)
        end
    end
    antiLagConnections = {}
    print("[MCJ] Anti Lag: Đã tắt")
end

