local function createTabButton(icon, name, positionY)
    local btn = Instance.new("TextButton", sidebar)
    btn.Size = UDim2.new(1, -10, 0, 50)
    btn.Position = UDim2.new(0, 5, 0, positionY)
    btn.BackgroundColor3 = Color3.fromRGB(33, 38, 45)
    btn.Text = ""
    btn.AutoButtonColor = false
    
    local btnCorner = Instance.new("UICorner", btn)
    btnCorner.CornerRadius = UDim.new(0, 6)
    
    local btnStroke = Instance.new("UIStroke", btn)
    btnStroke.Color = Color3.fromRGB(65, 70, 80)
    btnStroke.Thickness = 1
    
    local iconLabel = Instance.new("TextLabel", btn)
    iconLabel.Size = UDim2.new(1, 0, 0.6, 0)
    iconLabel.Position = UDim2.new(0, 0, 0.1, 0)
    iconLabel.BackgroundTransparency = 1
    iconLabel.Text = icon
    iconLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    iconLabel.Font = Enum.Font.Gotham
    iconLabel.TextSize = 20
    
    local nameLabel = Instance.new("TextLabel", btn)
    nameLabel.Size = UDim2.new(1, 0, 0.3, 0)
    nameLabel.Position = UDim2.new(0, 0, 0.7, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = name
    nameLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    nameLabel.Font = Enum.Font.Gotham
    nameLabel.TextSize = 10
    
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 45, 52)}):Play()
        TweenService:Create(iconLabel, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        TweenService:Create(nameLabel, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(200, 200, 200)}):Play()
    end)
    
    btn.MouseLeave:Connect(function()
        if tabs[name] ~= currentTab then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(33, 38, 45)}):Play()
            TweenService:Create(iconLabel, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(150, 150, 150)}):Play()
            TweenService:Create(nameLabel, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(150, 150, 150)}):Play()
        end
    end)
    
    btn.MouseButton1Click:Connect(function()
        currentTab = name
        for tabName, _ in pairs(tabs) do
            local tabBtn = tabs[tabName].button
            if tabName == name then
                TweenService:Create(tabBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(48, 54, 61)}):Play()
                TweenService:Create(tabBtn.UIStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(106, 17, 203)}):Play()
                TweenService:Create(tabBtn:FindFirstChild("TextLabel"), TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
                TweenService:Create(tabBtn:FindFirstChild("TextLabel"):FindFirstChild("TextLabel"), TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(200, 200, 200)}):Play()
                tabs[tabName].container.Visible = true
            else
                TweenService:Create(tabBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(33, 38, 45)}):Play()
                TweenService:Create(tabBtn.UIStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(65, 70, 80)}):Play()
                TweenService:Create(tabBtn:FindFirstChild("TextLabel"), TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(150, 150, 150)}):Play()
                TweenService:Create(tabBtn:FindFirstChild("TextLabel"):FindFirstChild("TextLabel"), TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(150, 150, 150)}):Play()
                tabs[tabName].container.Visible = false
            end
        end
    end)
    
    return btn
end

