local function makeToggleButton(name, initialState, callback, container)
    local toggleState = initialState
    
    local btn = Instance.new("TextButton", container)
    btn.Size = UDim2.new(1, -20, 0, 45)
    btn.BackgroundColor3 = initialState and Color3.fromRGB(20, 100, 50) or Color3.fromRGB(33, 38, 45)
    btn.Text = ""
    btn.AutoButtonColor = false
    
    local btnCorner = Instance.new("UICorner", btn)
    btnCorner.CornerRadius = UDim.new(0, 6)
    
    local btnStroke = Instance.new("UIStroke", btn)
    btnStroke.Color = initialState and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(65, 70, 80)
    btnStroke.Thickness = 1
    
    local titleLabel = Instance.new("TextLabel", btn)
    titleLabel.Size = UDim2.new(0.7, 0, 1, 0)
    titleLabel.Position = UDim2.new(0, 15, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = name
    titleLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    titleLabel.Font = Enum.Font.Gotham
    titleLabel.TextSize = 14
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    
    local statusLabel = Instance.new("TextLabel", btn)
    statusLabel.Size = UDim2.new(0.25, 0, 1, 0)
    statusLabel.Position = UDim2.new(0.75, 0, 0, 0)
    statusLabel.BackgroundTransparency = 1
    statusLabel.Text = initialState and "ON" or "OFF"
    statusLabel.TextColor3 = initialState and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(255, 100, 100)
    statusLabel.Font = Enum.Font.GothamBold
    statusLabel.TextSize = 12
    
    btn.MouseButton1Click:Connect(function()
        toggleState = not toggleState
        if toggleState then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(20, 100, 50)}):Play()
            TweenService:Create(btnStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(0, 200, 100)}):Play()
            statusLabel.Text = "ON"
            TweenService:Create(statusLabel, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(0, 255, 150)}):Play()
        else
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(33, 38, 45)}):Play()
            TweenService:Create(btnStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(65, 70, 80)}):Play()
            statusLabel.Text = "OFF"
            TweenService:Create(statusLabel, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 100, 100)}):Play()
        end
        callback(toggleState)
    end)
    
    return btn
end

-- ========== XRAY BASE ==========
local function handleNewPart(part)
    if xrayEnabled and (part:IsA("Part") or part:IsA("MeshPart") or part:IsA("UnionOperation")) then
        local name = part.Name:lower()
        if name:find("structure") or name:find("base") or name:find("home") then
            if not originalTransparency[part] then
                originalTransparency[part] = part.Transparency
            end
            part.Transparency = 0.9
        end
    end
end

local function setTransparency()
    for _, part in pairs(workspace:GetDescendants()) do
        if part:IsA("Part") or part:IsA("MeshPart") or part:IsA("UnionOperation") then
            local name = part.Name:lower()
            if name:find("structure") or name:find("base") or name:find("home") then
                if not originalTransparency[part] then
                    originalTransparency[part] = part.Transparency
                end
                part.Transparency = 0.9
            end
        end
    end
end

local function enableXrayBase()
    if xrayEnabled then return end
    xrayEnabled = true
    print("[MCJ] Xray Base: Đang bật...")
    setTransparency()
    descendantConnection = workspace.DescendantAdded:Connect(handleNewPart)
    print("[MCJ] Xray Base: Đã bật")
end

local function disableXrayBase()
    if not xrayEnabled then return end
    xrayEnabled = false
    print("[MCJ] Xray Base: Đang tắt...")
    if descendantConnection then
        descendantConnection:Disconnect()
        descendantConnection = nil
    end
    local restoredCount = 0
    for part, originalTrans in pairs(originalTransparency) do
        if part and part.Parent then
            part.Transparency = originalTrans
            restoredCount = restoredCount + 1
        end
    end
    originalTransparency = {}
    print("[MCJ] Xray Base: Đã tắt - " .. restoredCount .. " part được khôi phục")
end

-- ========== ESP BASE ==========
local function getRainbowColor()
    local time = tick() * 0.5
    local r = math.sin(time * 1.5) * 0.5 + 0.5
    local g = math.sin(time * 1.5 + 2) * 0.5 + 0.5
    local b = math.sin(time * 1.5 + 4) * 0.5 + 0.5
    return Color3.new(r, g, b)
end

local function updateEspBase()
    if not espBaseEnabled then
        for _, instance in pairs(lteInstances) do
            if instance then
                instance:Destroy()
            end
        end
        lteInstances = {}
        return
    end

    local currentTime = tick()
    local shouldUpdateText = (currentTime - lastUpdateTime) >= updateInterval

    for _, plot in pairs(workspace.Plots:GetChildren()) do
        local purchases = plot:FindFirstChild("Purchases")
        if purchases then
            local plotBlock = purchases:FindFirstChild("PlotBlock")
            if plotBlock then
                local main = plotBlock:FindFirstChild("Main")
                if main then
                    local billboardGui = main:FindFirstChild("BillboardGui")
                    if billboardGui then
                        local timeLabel = billboardGui:FindFirstChild("RemainingTime")
                        if timeLabel and timeLabel:IsA("TextLabel") then
                            local espName = "LockTimeESP_" .. plot.Name
                            local existingBillboard = plot:FindFirstChild(espName)
                            local rainbowColor = getRainbowColor()
                            
                            if not existingBillboard then
                                local billboard = Instance.new("BillboardGui")
                                billboard.Name = espName
                                billboard.Size = UDim2.new(0, 150, 0, 30)
                                billboard.StudsOffset = Vector3.new(0, 4, 0)
                                billboard.AlwaysOnTop = true
                                billboard.Adornee = main
                                
                                local label = Instance.new("TextLabel")
                                label.Text = timeLabel.Text == "0s" and "🔓 UNLOCKED" or ("🔒 " .. timeLabel.Text)
                                label.Size = UDim2.new(1, 0, 1, 0)
                                label.BackgroundTransparency = 1
                                label.TextScaled = false
                                label.TextSize = 30
                                label.TextColor3 = rainbowColor
                                label.TextStrokeColor3 = Color3.new(0, 0, 0)
                                label.TextStrokeTransparency = 0.2
                                label.Font = Enum.Font.Gotham
                                label.Parent = billboard
                                
                                billboard.Parent = plot
                                lteInstances[plot.Name] = billboard
                            else
                                if shouldUpdateText then
                                    existingBillboard.TextLabel.Text = timeLabel.Text == "0s" and "🔓 UNLOCKED" or ("🔒 " .. timeLabel.Text)
                                end
                                existingBillboard.TextLabel.TextColor3 = rainbowColor
                            end
                        end
                    end
                end
            end
        end
    end
    
    if shouldUpdateText then
        lastUpdateTime = currentTime
    end
end

local function enableEspBase()
    if espBaseEnabled then return end
    espBaseEnabled = true
    print("[MCJ] ESP Base: Đã bật")
    task.spawn(function()
        while espBaseEnabled do
            updateEspBase()
            task.wait(0.05)
        end
    end)
end

local function disableEspBase()
    if not espBaseEnabled then return end
    espBaseEnabled = false
    print("[MCJ] ESP Base: Đã tắt")
    updateEspBase()
end

-- ========== DEVELOP BASE ESP ==========
local function FindDevelopBase()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, plot in ipairs(plots:GetChildren()) do
        local sign = plot:FindFirstChild("PlotSign")
        if sign then
            local yourBase = sign:FindFirstChild("YourBase")
            if yourBase and yourBase.Enabled then
                return plot
            end
        end
    end
    return nil
end

local function ClearEffects()
    for _, v in ipairs(workspace:GetDescendants()) do
        if v.Name == "MCJ_DEV_OUTLINE" or v.Name == "MCJ_DEV_LABEL" then
            v:Destroy()
        end
    end
end

local function AddOutline(part)
    if part:FindFirstChild("MCJ_DEV_OUTLINE") then return end
    local box = Instance.new("SelectionBox")
    box.Name = "MCJ_DEV_OUTLINE"
    box.Adornee = part
    box.LineThickness = 0.05
    box.Color3 = Color3.fromRGB(40, 140, 255)
    box.SurfaceTransparency = 1
    box.Transparency = 0
    box.Parent = part
end

local function CreateLabel(plot)
    local old = plot:FindFirstChild("MCJ_DEV_LABEL")
    if old then old:Destroy() end
    local part = plot:FindFirstChildWhichIsA("BasePart", true)
    if not part then return end
    local gui = Instance.new("BillboardGui")
    gui.Name = "MCJ_DEV_LABEL"
    gui.Adornee = part
    gui.AlwaysOnTop = true
    gui.Size = UDim2.new(10, 0, 4, 0)
    gui.StudsOffset = Vector3.new(0, 7, 0)
    gui.Parent = plot
    local text = Instance.new("TextLabel")
    text.BackgroundTransparency = 1
    text.Size = UDim2.new(1, 0, 1, 0)
    text.TextScaled = true
    text.Font = Enum.Font.GothamBold
    text.TextColor3 = Color3.fromRGB(70, 120, 255)
    text.TextStrokeTransparency = 0.2
    text.TextStrokeColor3 = Color3.fromRGB(10, 30, 80)
    text.Text = "YOUR BASE"
    text.Parent = gui
end

local function ApplyEffects(plot)
    for _, inst in ipairs(plot:GetDescendants()) do
        if inst:IsA("BasePart") then
            local nameLower = inst.Name:lower()
            if nameLower:find("structure") or nameLower:find("base") or nameLower:find("home") then
                AddOutline(inst)
            end
        end
    end
    local hitbox = plot:FindFirstChild("DeliveryHitbox", true)
    if hitbox and hitbox:IsA("BasePart") then
        AddOutline(hitbox)
    end
end

local function SetupDevelopESP()
    ClearEffects()
    local base = FindDevelopBase()
    if base then
        ApplyEffects(base)
        CreateLabel(base)
        print("[MCJ] Develop Base ESP: Đã bật!")
        return true
    else
        print("[MCJ] Không tìm thấy plot của bạn")
        return false
    end
end

local function StartDevelopESP()
    if developEspEnabled then return end
    developEspEnabled = true
    local success = SetupDevelopESP()
    if not success then return end
    developEspConnection = RunService.Heartbeat:Connect(function()
        local base = FindDevelopBase()
        if not base then return end
        for _, inst in ipairs(base:GetDescendants()) do
            if inst:IsA("BasePart") then
                local nameLower = inst.Name:lower()
                local needOutline = nameLower:find("structure") or nameLower:find("base") or nameLower:find("home")
                if needOutline and not inst:FindFirstChild("MCJ_DEV_OUTLINE") then
                    AddOutline(inst)
                end
            end
        end
        local hitbox = base:FindFirstChild("DeliveryHitbox", true)
        if hitbox and not hitbox:FindFirstChild("MCJ_DEV_OUTLINE") then
            AddOutline(hitbox)
        end
    end)
end

local function StopDevelopESP()
    if not developEspEnabled then return end
    developEspEnabled = false
    if developEspConnection then
        developEspConnection:Disconnect()
        developEspConnection = nil
    end
    ClearEffects()
    print("[MCJ] Develop Base ESP: Đã tắt")
end

-- ========== ANTI LAG ==========
local character = player.Character or player.CharacterAdded:Wait()

local function removeClothes()
    if not character then return end
    for _, v in pairs(character:GetChildren()) do
        if v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("Accessory") then
            v:Destroy()
        end
    end
end

local function removePartTextures(obj)
    if obj:IsA("Texture") or obj:IsA("Decal") or obj:IsA("SurfaceAppearance") then
        obj:Destroy()
    end
end

local function enableAntiLag()
    if antiLagEnabled then return end
    antiLagEnabled = true
    print("[MCJ] Anti Lag: Đang bật...")
    
    removeClothes()
    
    local charConnection = player.CharacterAdded:Connect(function(c)
        character = c
        task.wait(0.1)
        removeClothes()
    end)
    table.insert(antiLagConnections, charConnection)
    
    local clothesLoop = task.spawn(function()
        while antiLagEnabled do
            if character then removeClothes() end
            task.wait(1)
        end
    end)
    table.insert(antiLagConnections, clothesLoop)
    
    for _,v in pairs(workspace:GetDescendants()) do
        removePartTextures(v)
    end
    local textureConnection = workspace.DescendantAdded:Connect(removePartTextures)
    table.insert(antiLagConnections, textureConnection)
    
    print("[MCJ] Anti Lag: Đã bật")
end

local function disableAntiLag()
    if not antiLagEnabled then return end
    antiLagEnabled = false
    print("[MCJ] Anti Lag: Đang tắt...")
    for _, connection in pairs(antiLagConnections) do
        if type(connection) == "userdata" and connection.Connected then
            connection:Disconnect()
        elseif type(connection) == "thread" then
            task.cancel(connection)
        end
    end
    antiLagConnections = {}
    print("[MCJ] Anti Lag: Đã tắt")
end

