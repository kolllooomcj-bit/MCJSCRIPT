-- ========== HÀM THÔNG BÁO GUI ==========
local function createNotification(text, color)
    local screenGui = player:WaitForChild("PlayerGui")
    
    -- Xóa thông báo cũ
    local oldNotif = screenGui:FindFirstChild("AnimationNotification")
    if oldNotif then oldNotif:Destroy() end
    
    local notification = Instance.new("ScreenGui", screenGui)
    notification.Name = "AnimationNotification"
    notification.ResetOnSpawn = false
    
    local frame = Instance.new("Frame", notification)
    frame.Size = UDim2.new(0, 250, 0, 60)
    frame.Position = UDim2.new(0.5, -125, 0.15, 0)
    frame.BackgroundColor3 = color
    frame.BackgroundTransparency = 0.2
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)
    
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = color
    stroke.Thickness = 2
    
    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, 0, 1, 0)
    label.Text = text
    label.TextColor3 = Color3.new(1, 1, 1)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.BackgroundTransparency = 1
    
    -- Hiệu ứng xuất hiện
    game:GetService("TweenService"):Create(frame, TweenInfo.new(0.3), {
        Position = UDim2.new(0.5, -125, 0.2, 0),
        Transparency = 0.2
    }):Play()
    
    -- Tự động biến mất sau 2 giây
    task.delay(2, function()
        if notification then
            game:GetService("TweenService"):Create(frame, TweenInfo.new(0.3), {
                Position = UDim2.new(0.5, -125, 0.15, 0),
                Transparency = 1
            }):Play()
            
            task.delay(0.3, function()
                notification:Destroy()
            end)
        end
    end)
end

-- ========== PHẦN 1: STOP BASIC ANIMATIONS (CTRL+K) ==========
local function enableAutoStop()
    if isAutoStopEnabled then return end
    isAutoStopEnabled = true
    
    createNotification("✅ ANIMATION: ĐÃ Dừng\nMọi animation sẽ bị dừng", Color3.fromRGB(40, 180, 80))
    
    autoStopConnection = RunService.Heartbeat:Connect(function()
        local character = player.Character
        if not character then return end
        
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end
        
        -- Dừng TẤT CẢ animation (mạnh hơn phần 1)
        for _, track in pairs(humanoid:GetPlayingAnimationTracks()) do
            track:Stop()
        end
    end)
    
    print("Animation Stop (Ctrl+K): ĐÃ BẬT")
end

local function disableAutoStop()
    if not isAutoStopEnabled then return end
    isAutoStopEnabled = false
    
    createNotification("❌ ANIMATION: ĐÃ TẮT\nAnimation hoạt động bình thường", Color3.fromRGB(220, 60, 60))
    
    if autoStopConnection then
        autoStopConnection:Disconnect()
        autoStopConnection = nil
    end
    
    print("Animation Stop (Ctrl+K): ĐÃ TẮT")
end

local function toggleAutoStop()
    if isAutoStopEnabled then
        disableAutoStop()
    else
        enableAutoStop()
    end
end

-- Kết nối phím Ctrl+K
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    
    if input.KeyCode == Enum.KeyCode.K then
        local ctrlPressed = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or 
                           UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
        
        if ctrlPressed then
            toggleAutoStop()
        end
    end
end)

-- ========== PHẦN 2: HIDE HEAD & FACE ==========
local function hideHeadAndFace()
    if not isHeadActive then return end
    
    local character = player.Character
    if not character then return end
    
    local head = character:FindFirstChild("Head")
    if not head or not head:IsA("BasePart") then return end
    
    if head == lastHead and head.LocalTransparencyModifier == 1 then
        return
    end
    
    lastHead = head
    head.LocalTransparencyModifier = 1
    
    for _, child in ipairs(head:GetChildren()) do
        if child:IsA("Decal") then
            child.Transparency = 1
        end
    end
    
    if not head:GetAttribute("TransparencyWatch") then
        head:SetAttribute("TransparencyWatch", true)
        head:GetPropertyChangedSignal("LocalTransparencyModifier"):Connect(function()
            if isHeadActive and head.LocalTransparencyModifier ~= 1 then
                head.LocalTransparencyModifier = 1
            end
        end)
    end
end

-- Kết nối ẩn đầu
RunService.Heartbeat:Connect(function()
    if isHeadActive and player.Character then
        hideHeadAndFace()
    end
end)

player.CharacterAdded:Connect(function(character)
    task.wait(1)
    lastHead = nil
    if isHeadActive then
        hideHeadAndFace()
    end
end)

