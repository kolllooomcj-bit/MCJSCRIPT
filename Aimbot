-- ========== ESP FUNCTION HOÀN CHỈNH ==========
local function createESPForPlayer(player)
    if not espEnabled or player == LocalPlayer then return end
    
    -- Xóa ESP cũ nếu có
    if espData[player] then
        if espData[player].billboard then
            espData[player].billboard:Destroy()
        end
        if espData[player].beam then
            espData[player].beam:Destroy()
        end
        if espData[player].connection then
            espData[player].connection:Disconnect()
        end
    end
    
    espData[player] = {}
    
    local function setupESP(char)
        if not char then return end
        
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local head = char:FindFirstChild("Head")
        
        if humanoid and head then
            -- Tạo BillboardGui
            local billboard = Instance.new("BillboardGui")
            billboard.Name = "ESP_" .. player.Name
            billboard.Adornee = head
            billboard.Size = UDim2.new(0, 200, 0, 50)
            billboard.StudsOffset = Vector3.new(0, 3, 0)
            billboard.AlwaysOnTop = true
            billboard.Enabled = espEnabled
            billboard.Parent = head
            
            local nameLabel = Instance.new("TextLabel")
            nameLabel.Text = player.Name
            nameLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
            nameLabel.BackgroundTransparency = 1
            nameLabel.TextSize = 16
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.Size = UDim2.new(1, 0, 1, 0)
            nameLabel.Parent = billboard
            
            -- Tạo Beam
            local beam = Instance.new("Beam")
            beam.Color = ColorSequence.new(Color3.fromRGB(255, 0, 0))
            beam.Width0 = 0.2
            beam.Width1 = 0.2
            beam.Enabled = espEnabled
            beam.Parent = workspace
            
            -- Tạo attachments
            local localHead = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
            if localHead then
                local attachment0 = Instance.new("Attachment")
                attachment0.Parent = localHead
                
                local attachment1 = Instance.new("Attachment")
                attachment1.Parent = head
                
                beam.Attachment0 = attachment0
                beam.Attachment1 = attachment1
            end
            
            espData[player].billboard = billboard
            espData[player].beam = beam
            espData[player].head = head
        end
    end
    
    -- Setup ESP cho character hiện tại
    if player.Character then
        setupESP(player.Character)
    end
    
    -- Kết nối khi player thay đổi character
    espData[player].connection = player.CharacterAdded:Connect(function(char)
        wait(1) -- Đợi character load
        if espEnabled then
            setupESP(char)
        end
    end)
end

local function removeESPForPlayer(player)
    if espData[player] then
        if espData[player].billboard then
            espData[player].billboard:Destroy()
        end
        if espData[player].beam then
            espData[player].beam:Destroy()
        end
        if espData[player].connection then
            espData[player].connection:Disconnect()
        end
        espData[player] = nil
    end
end

local function updateAllESP()
    -- Xóa tất cả ESP cũ
    for player, data in pairs(espData) do
        removeESPForPlayer(player)
    end
    
    if not espEnabled then return end
    
    -- Tạo ESP cho tất cả player hiện tại
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            createESPForPlayer(player)
        end
    end
end

