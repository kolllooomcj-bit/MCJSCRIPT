-- Aimbot Loop
RunService.Heartbeat:Connect(function()
    if aimbotEnabled then
        local targetHead = getClosestHead()
        if targetHead then
            local camera = workspace.CurrentCamera
            local targetPosition = targetHead.Position + Vector3.new(0, 0.5, 0)
            camera.CFrame = CFrame.new(camera.CFrame.Position, targetPosition)
        end
    end
end)

-- POV Update Loop
RunService.Heartbeat:Connect(updatePOV)

-- ESP Beam Update Loop (đảm bảo beam luôn kết nối đúng)
RunService.Heartbeat:Connect(function()
    if espEnabled then
        local localHead = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
        if localHead then
            for player, data in pairs(espData) do
                if data.beam and data.beam.Enabled and player.Character then
                    local targetHead = player.Character:FindFirstChild("Head")
                    if targetHead then
                        -- Đảm bảo attachments tồn tại
                        if not data.beam.Attachment0 then
                            local attachment0 = Instance.new("Attachment")
                            attachment0.Parent = localHead
                            data.beam.Attachment0 = attachment0
                        end
                        if not data.beam.Attachment1 then
                            local attachment1 = Instance.new("Attachment")
                            attachment1.Parent = targetHead
                            data.beam.Attachment1 = attachment1
                        end
                    end
                end
            end
        end
    end
end)

