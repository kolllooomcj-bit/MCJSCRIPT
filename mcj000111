local isActive = true
local lastHead = nil

local function hideHeadAndFace()
    if not isActive then return end

    local character = player.Character
    if not character then return end

    local head = character:FindFirstChild("Head")
    if not head or not head:IsA("BasePart") then return end

    -- Chỉ chạy khi head thay đổi hoặc transparency bị reset
    if head == lastHead and head.LocalTransparencyModifier == 1 then
        return
    end

    lastHead = head

    -- Ẩn head
    head.LocalTransparencyModifier = 1

    -- Ẩn face và decals + theo dõi changes
    for _, child in ipairs(head:GetChildren()) do
        if child:IsA("Decal") then
            child.Transparency = 1
            -- Nếu decal bị reset, sẽ phát hiện qua property changed
        end
    end

    -- Theo dõi nếu transparency bị reset
    if not head:GetAttribute("TransparencyWatch") then
        head:SetAttribute("TransparencyWatch", true)

        head:GetPropertyChangedSignal("LocalTransparencyModifier"):Connect(function()
            if isActive and head.LocalTransparencyModifier ~= 1 then
                head.LocalTransparencyModifier = 1
            end
        end)
    end
end

